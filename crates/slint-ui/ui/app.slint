import { Theme, Caption, Badge, Stat } from "common.slint";
import { LogView, LogBar, LogPartyRow, LogSection } from "logs.slint";
import { Button, CheckBox, LineEdit, TextEdit, ComboBox, SpinBox, ScrollView, ListView, VerticalBox, HorizontalBox, Palette, AboutSlint } from "std-widgets.slint";

export struct PetRow {
    name: string, element: string, element-color: color, class-name: string,
    status: string, base-growth: string, growth: string, dungeon-level: string, class-level: string,
    recommended: string, difficulty: string, action: string, ranking: string,
}
export struct PetDetails {
    name: string, element: string, element-color: color, ownership: string,
    base-growth: string, effective-growth: string, recommended-class: string,
    readiness: string,
}
export struct DetailSection { title: string, body: string }
export struct ChoiceSetting { key: string, label: string, options: [string], current: int }
export struct NumberSetting { key: string, label: string, value: string, hint: string }

export component MainWindow inherits Window {
    title: "ITRTG Pet Planner · Slint Prototype";
    preferred-width: 1920px; preferred-height: 1080px;
    min-width: 1000px; min-height: 660px;
    background: Theme.background; default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    in-out property <int> active-view;
    in-out property <int> log-tab;
    in property <string> log-heading;
    in property <[LogPartyRow]> log-party;
    in property <[LogSection]> log-overview;
    in property <[LogSection]> log-combat;
    in property <[LogBar]> log-bars;
    in property <[string]> log-pet-names;
    in property <[string]> log-room-names;
    in property <int> log-pet;
    in property <int> log-metric;
    in property <int> log-room;
    in property <bool> log-supporter;
    in property <bool> log-loaded;
    in property <bool> log-all-rooms;
    callback log-choice(string, int);
    callback clear-log();
    in property <[PetRow]> pets;
    in property <[DetailSection]> detail-sections;
    in property <[ChoiceSetting]> advanced-filters;
    in property <[NumberSetting]> number-settings;
    in property <string> rates-summary;
    in property <string> roster-summary;
    in property <string> target-result;
    in property <string> ranking-title;
    in property <bool> show-ranking;
    in property <bool> has-wiki;
    in-out property <string> custom-target;
    in-out property <bool> ascending;
    in-out property <bool> use-egg;
    in-out property <bool> include-equipment;
    in-out property <bool> include-class;
    in-out property <bool> stone-upgrade;
    in-out property <bool> earth-lock: true;
    in-out property <int> tiebreak;
    in-out property <int> import-kind;
    private property <bool> settings-open;
    private property <bool> wide: true;
    changed width => { root.wide = root.width >= 1700px; }
    callback choice-changed(string, int);
    callback number-changed(string, string);
    callback flag-changed(string, bool);
    callback open-wiki();
    in property <PetDetails> details;
    in property <string> selected-name;
    in property <string> owned-count: "0";
    in property <string> evolved-count: "0";
    in property <string> ready-count: "0";
    in property <string> visible-summary;
    in property <string> source-label: "Wiki reference";
    in property <string> status;
    in property <bool> status-error;
    in property <bool> import-busy;
    in property <string> multiplier-label;
    in-out property <string> query;
    in-out property <int> ownership-index;
    in-out property <int> element-index;
    in-out property <int> sort-index;
    in-out property <int> pgc-done;
    in-out property <int> pgc-max: 25;
    in-out property <bool> import-open;
    in-out property <string> import-text;
    private property <bool> about-open;
    out property <bool> modal-open: root.import-open || root.about-open || root.settings-open || root.import-busy;

    callback filters-changed(string, int, int, int);
    callback select-pet(string);
    callback sort-header(int);
    callback pgc-changed(int, int);
    callback reset-filters();
    callback load-example();
    callback import-paste(string);
    callback open-file();

    VerticalBox {
        padding: 24px; spacing: 16px;
        HorizontalBox { padding: 0px;
            height: 58px; spacing: 16px;
            VerticalBox {
                padding: 0px; spacing: 5px;
                Caption { text: "ITRTG  /  SLINT PROTOTYPE"; color: Theme.accent; }
                Text { text: root.active-view == 0 ? "Pet analyzer" : "Dungeon logs"; color: Theme.text; font-size: 28px; font-weight: 600; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Analyzer"; enabled: !root.modal-open; primary: root.active-view == 0; clicked => { root.active-view = 0; } }
            Button { text: "Dungeon logs"; enabled: !root.modal-open; primary: root.active-view == 1; clicked => { root.active-view = 1; } }
            if root.active-view == 0: Button { text: "Growth & campaigns"; enabled: !root.modal-open; clicked => { root.settings-open = true; } }
            if root.active-view == 0: Button { text: "Load example"; enabled: !root.import-busy && !root.modal-open; clicked => { root.load-example(); } }
            Button { text: "Import data…"; enabled: !root.import-busy && !root.modal-open; primary: true; clicked => { if root.active-view == 1 { root.import-kind = 3; } root.import-open = true; } }
            Button { text: "About"; enabled: !root.modal-open; clicked => { root.about-open = true; } }
        }
        if root.active-view == 0: VerticalBox { padding: 0px; spacing: 16px;
        HorizontalBox { padding: 0px;
            spacing: 12px; height: 76px;
            Stat { value: root.owned-count; label: "OWNED PETS"; }
            Stat { value: root.evolved-count; label: "EVOLVED · OWNED"; }
            Stat { value: root.ready-count; label: "GROWTH READY · OWNED"; }
            Rectangle {
                background: Theme.panel; border-radius: 8px; min-width: 285px;
                VerticalBox {
                    padding: 12px; spacing: 5px;
                    Caption { text: "PATREON GOD CHALLENGES · " + root.multiplier-label; }
                    HorizontalBox { padding: 0px;
                        spacing: 6px;
                        SpinBox { enabled: !root.modal-open; value <=> root.pgc-done; minimum: 0; maximum: root.pgc-max; accessible-label: "PGC completed"; edited(v) => { root.pgc-changed(v, root.pgc-max); } }
                        Caption { text: "/"; vertical-alignment: center; }
                        SpinBox { enabled: !root.modal-open; value <=> root.pgc-max; minimum: 0; maximum: 1000; accessible-label: "PGC maximum"; edited(v) => { root.pgc-changed(root.pgc-done, v); } }
                    }
                }
            }
        }
        HorizontalBox { padding: 0px;
            height: 36px; spacing: 10px;
            LineEdit { enabled: !root.modal-open; text <=> root.query; placeholder-text: "Search names or abilities…"; accessible-label: "Search pets"; horizontal-stretch: 1;
                edited => { root.filters-changed(root.query, root.ownership-index, root.element-index, root.sort-index); }
            }
            ComboBox { enabled: !root.modal-open; model: ["All pets", "Owned", "Locked"]; current-index <=> root.ownership-index; width: 130px;
                selected(_) => { root.filters-changed(root.query, root.ownership-index, root.element-index, root.sort-index); }
            }
            ComboBox { enabled: !root.modal-open; model: ["All elements", "Fire", "Water", "Wind", "Earth", "Neutral", "All"]; current-index <=> root.element-index; width: 140px;
                selected(_) => { root.filters-changed(root.query, root.ownership-index, root.element-index, root.sort-index); }
            }
            ComboBox { enabled: !root.modal-open; model: ["Name", "Effective growth", "Dungeon level", "Class level", "Element", "Recommended class", "Evo difficulty", "Your class", "Action", "Time to evolve", "Time to target", "Campaign bonus"]; current-index <=> root.sort-index; width: 165px;
                selected(_) => { root.filters-changed(root.query, root.ownership-index, root.element-index, root.sort-index); }
            }
            CheckBox { text: "Ascending"; checked <=> root.ascending; enabled: !root.modal-open; toggled => { root.flag-changed("ascending", self.checked); } }
            Button { text: "Reset filters"; enabled: !root.modal-open; clicked => { root.reset-filters(); } }
        }
        HorizontalBox { padding: 0px; height: 60px; spacing: 10px;
            for setting in root.advanced-filters: VerticalBox {
                padding: 0px; spacing: 5px;
                Caption { text: setting.label; }
                ComboBox { model: setting.options; current-index: setting.current; enabled: !root.modal-open; accessible-label: setting.label;
                    selected(_) => { root.choice-changed(setting.key, self.current-index); }
                }
            }
        }
        HorizontalBox { padding: 0px;
            spacing: 16px;
            Rectangle {
                background: Theme.panel; border-radius: 8px; horizontal-stretch: 1; min-width: 610px;
                VerticalBox {
                    padding: 12px; spacing: 8px;
                    Caption { text: root.visible-summary + "  ·  " + root.source-label; height: 20px; }
                    Caption { text: root.roster-summary; wrap: word-wrap; }
                    HorizontalBox { padding: 0px;
                        height: 25px; spacing: 10px;
                        Button { text: "PET";  horizontal-stretch: 1; min-width: 150px;  enabled: !root.modal-open; clicked => { root.sort-header(0); } }
                        Button { text: "ELEMENT";  width: 72px;  enabled: !root.modal-open; clicked => { root.sort-header(4); } }
                        Button { text: "CLASS";  width: 93px;  enabled: !root.modal-open; clicked => { root.sort-header(7); } }
                        if root.wide: Button { text: "RECOMMENDED";  width: 140px;  enabled: !root.modal-open; clicked => { root.sort-header(5); } }
                        if root.wide: Button { text: "EVO";  width: 55px;  enabled: !root.modal-open; clicked => { root.sort-header(6); } }
                        if root.wide: Button { text: "ACTION";  width: 100px;  enabled: !root.modal-open; clicked => { root.sort-header(8); } }
                        if root.show-ranking: Caption { text: root.ranking-title; width: 130px; }
                        Button { text: "GROWTH";  width: 94px;   enabled: !root.modal-open; clicked => { root.sort-header(1); } }
                        Button { text: "DL";  width: 36px;   enabled: !root.modal-open; clicked => { root.sort-header(2); } }
                        Button { text: "CL";  width: 36px;   enabled: !root.modal-open; clicked => { root.sort-header(3); } }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    if root.pets.length == 0: Caption { text: "No matching pets. Try another search or reset the filters."; height: 50px; horizontal-alignment: center; }
                    ListView {
                        for pet in root.pets: Rectangle {
                            height: 62px; background: pet.name == root.selected-name ? #253e48 : transparent; border-radius: 5px;
                            HorizontalBox {
                                padding: 3px; spacing: 10px;
                                VerticalBox { padding: 0px; spacing: 2px; horizontal-stretch: 1; min-width: 144px;
                                    Button { enabled: !root.modal-open; text: pet.name; clicked => { root.select-pet(pet.name); } }
                                    Caption { text: pet.status; overflow: elide; font-size: 10px; }
                                }
                                Badge { label: pet.element; tint: pet.element-color; }
                                Text { text: pet.class-name; color: Theme.muted; width: 93px; overflow: elide; vertical-alignment: center; }
                                if root.wide: Text { text: pet.recommended; color: Theme.muted; width: 140px; overflow: elide; vertical-alignment: center; }
                                if root.wide: Text { text: pet.difficulty; color: Theme.muted; width: 55px; vertical-alignment: center; }
                                if root.wide: Text { text: pet.action; color: Theme.muted; width: 100px; overflow: elide; vertical-alignment: center; }
                                if root.show-ranking: Text { text: pet.ranking; color: Theme.accent; width: 130px; overflow: elide; vertical-alignment: center; }
                                VerticalBox { padding: 0px; spacing: 2px; width: 94px;
                                    Text { text: pet.growth; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                                    Caption { text: pet.base-growth; horizontal-alignment: right; font-size: 10px; }
                                }
                                Text { text: pet.dungeon-level; color: Theme.muted; width: 36px; horizontal-alignment: right; vertical-alignment: center; }
                                Text { text: pet.class-level; color: Theme.muted; width: 36px; horizontal-alignment: right; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
            Rectangle {
                width: root.wide ? 390px : 310px; background: Theme.panel; border-radius: 8px;
                ScrollView {
                    VerticalBox {
                        padding: 20px; spacing: 14px;
                        Caption { text: "PET DETAILS"; }
                        Text { text: root.details.name; color: Theme.text; font-size: 23px; font-weight: 600; wrap: word-wrap; }
                        HorizontalBox { padding: 0px;
                            height: 25px;
                            Badge { label: root.details.element; tint: root.details.element-color; }
                            Caption { text: root.details.ownership; vertical-alignment: center; }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        Caption { text: "RECOMMENDED CLASS"; }
                        Text { text: root.details.recommended-class; color: Theme.text; wrap: word-wrap; }
                        HorizontalBox { padding: 0px;
                            VerticalBox { padding: 0px; spacing: 5px; Caption { text: "BASE GROWTH"; } Text { text: root.details.base-growth; color: Theme.text; font-size: 20px; } }
                            VerticalBox { padding: 0px; spacing: 5px; Caption { text: "EFFECTIVE"; } Text { text: root.details.effective-growth; color: Theme.accent; font-size: 20px; } }
                        }
                        Caption { text: "Effective includes PGC and an equipped Magic Egg."; wrap: word-wrap; }
                        Rectangle { height: 1px; background: Theme.line; }
                        Text { text: root.details.readiness; color: Theme.accent; font-weight: 600; }
                        Caption { text: "Readiness checks growth only. Materials and special conditions still apply."; wrap: word-wrap; }
                        Button { text: "Open wiki page"; enabled: root.has-wiki && !root.modal-open; clicked => { root.open-wiki(); } }
                        Caption { text: "CUSTOM DISPLAYED-GROWTH TARGET"; wrap: word-wrap; }
                        HorizontalBox { padding: 0px; spacing: 6px;
                            target-input := LineEdit { text <=> root.custom-target; placeholder-text: "e.g. 55,555"; enabled: !root.modal-open; accessible-label: "Custom growth target"; accepted(v) => { root.number-changed("custom", v); } }
                            Button { text: "Estimate"; enabled: !root.modal-open; clicked => { root.number-changed("custom", target-input.text); } }
                        }
                        Text { text: root.target-result; color: Theme.muted; wrap: word-wrap; }
                        for section in root.detail-sections: VerticalBox {
                            padding: 0px; spacing: 10px;
                            Rectangle { height: 1px; background: Theme.line; }
                            Caption { text: section.title; }
                            Text { text: section.body; color: Theme.text; wrap: word-wrap; min-height: self.preferred-height; vertical-stretch: 0; }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }
        }
        if root.active-view == 1: LogView {
            enabled: !root.modal-open;
            loaded: root.log-loaded; heading: root.log-heading; party: root.log-party;
            overview: root.log-overview; combat: root.log-combat; bars: root.log-bars;
            pet-names: root.log-pet-names; room-names: root.log-room-names;
            pet: root.log-pet; room: root.log-room; metric: root.log-metric; supporter: root.log-supporter;
            section <=> root.log-tab; all-rooms: root.log-all-rooms;
            choose(key,index) => { root.log-choice(key,index); }
            clear => { root.clear-log(); }
            import-log => { root.import-kind = 3; root.import-open = true; }
        }
        Text { text: root.status; color: root.status-error ? #ff9898 : Theme.muted; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
    }
    if root.import-open: Rectangle {
        background: #0009;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 760px; height: 530px; background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.line;
            VerticalBox {
                padding: 24px; spacing: 14px;
                Text { text: "Import game data"; color: Theme.text; font-size: 23px; vertical-stretch: 0; }
                ComboBox { model: ["Pet Stats — replace roster", "Main Stats — update account settings", "Full save — replace roster and account settings", "Dungeon log — HTML run report"]; current-index <=> root.import-kind; enabled: !root.import-busy; accessible-label: "Export type"; }
                Caption { text: root.import-kind == 3 ? "Open a dungeon log HTML file or paste its HTML source. The log stays in memory; your pet roster is kept." : root.import-kind == 0 ? "Pet Stats begins with Name;. Importing replaces the prototype roster." : root.import-kind == 2 ? "Import a full game save to replace the roster and fill account settings and Moai levels. Live actions and combat stats are unavailable." : "Main Stats begins with Idling to Rule the Gods. Only supported account settings are updated; the roster is kept."; wrap: word-wrap; }
                TextEdit { init => { self.focus(); } text <=> root.import-text; accessible-label: "Game data text"; enabled: !root.import-busy; wrap: no-wrap; }
                Text { text: root.status-error || root.import-busy ? root.status : "Imports stay on this device. Only planner data is saved; the raw full save is discarded after import."; color: root.status-error ? #ff9898 : Theme.muted; wrap: word-wrap; vertical-stretch: 0; }
                HorizontalBox { padding: 0px;
                    height: 36px;
                    Button { text: root.import-busy ? "Reading…" : "Open file…"; enabled: !root.import-busy; clicked => { root.open-file(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: "Cancel"; enabled: !root.import-busy; clicked => { root.import-open = false; } }
                    Button { text: "Import pasted text"; primary: true; enabled: !root.import-busy; clicked => { root.import-paste(root.import-text); } }
                }
            }
        }
    }
    if root.settings-open: Rectangle {
        background: #0009;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: 30px;
            width: 880px; height: parent.height - 60px;
            background: Theme.panel; border-radius: 10px;
            VerticalBox {
                padding: 24px; spacing: 12px;
                HorizontalBox { padding: 0px;
                    Text { text: "Growth & campaign settings"; font-size: 24px; color: Theme.text; }
                    Button { text: "Done"; clicked => { root.settings-open = false; } }
                }
                Text { text: root.rates-summary; color: Theme.accent; wrap: word-wrap; vertical-stretch: 0; }
                Caption { text: "Enter a value, then press Enter or Apply. Supports comma-separated and scientific notation."; wrap: word-wrap; }
                ScrollView {
                    VerticalBox { padding: 0px; spacing: 12px;
                        CheckBox { text: "Time-to-evolve estimates use a Magic Egg"; checked <=> root.use-egg; toggled => { root.flag-changed("egg", self.checked); } }
                        Caption { text: "Base-growth evolution requirements ignore both the egg and PGC multipliers."; wrap: word-wrap; }
                        ComboBox { model: ["Time sort ties: higher growth", "Time sort ties: easier evolution"]; current-index <=> root.tiebreak; selected(_) => { root.choice-changed("tiebreak", self.current-index); } }
                        CheckBox { text: "Include equipped campaign bonuses"; checked <=> root.include-equipment; toggled => { root.flag-changed("equipment", self.checked); } }
                        CheckBox { text: "Include class campaign bonuses"; checked <=> root.include-class; toggled => { root.flag-changed("class", self.checked); } }
                        CheckBox { text: "Stone +100% campaign upgrade bought"; checked <=> root.stone-upgrade; toggled => { root.flag-changed("stone", self.checked); } }
                        CheckBox { text: "Lock Earth Eater at +82% (off = lifetime planet calculation)"; checked <=> root.earth-lock; toggled => { root.flag-changed("earth-lock", self.checked); } }
                        for setting in root.number-settings: VerticalBox {
                            padding: 0px; spacing: 3px;
                            HorizontalBox { padding: 0px; height: 36px; spacing: 8px;
                                Text { text: setting.label; color: Theme.text; width: 260px; vertical-alignment: center; }
                                input := LineEdit { text: setting.value; accessible-label: setting.label; accepted(v) => { root.number-changed(setting.key, v); } }
                                Button { text: "Apply"; clicked => { root.number-changed(setting.key, input.text); } }
                            }
                            Caption { text: setting.hint; }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Text { text: root.status; color: root.status-error ? #ff9898 : Theme.muted; wrap: word-wrap; vertical-stretch: 0; }
            }
        }
    }
    if root.about-open: Rectangle {
        background: #0009;
        TouchArea { }
        Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 460px; height: 300px; background: Theme.panel; border-radius: 10px;
            VerticalBox {
                padding: 24px; spacing: 16px;
                Text { text: "ITRTG Pet Planner"; color: Theme.text; font-size: 22px; }
                Caption { text: "Experimental Slint frontend. This preview covers the pet analyzer; other screens remain in the existing app."; wrap: word-wrap; }
                AboutSlint { }
                Button { text: "Close"; clicked => { root.about-open = false; } }
            }
        }
    }
}
